{
  "name": "support-backend",
  "version": "1.0.0",
  "description": "Backend API for Support System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "node src/database/createdb.js",
    "db:migrate": "node src/database/migrate.js",
    "db:migrate:run": "node src/database/runMigration.js",
    "db:seed": "node src/database/seed.js",
    "db:setup": "npm run db:create && npm run db:migrate"
  },
  "keywords": [
    "support",
    "ticketing",
    "nodejs",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}